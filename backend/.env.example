# Copy this file to .env and fill in real values before running the server.

# --- Email (Resend API) ---
# Sent over HTTPS via Resend instead of raw Gmail SMTP, because most free
# cloud hosts (Render included) block outbound SMTP ports -- see emailer.py
# for the full explanation. Get a free API key at https://resend.com/api-keys
# (no card required) after signing up.
RESEND_API_KEY=re_your_api_key_here

# Sender shown on the email. Leave as-is unless you've verified your own
# domain on Resend (https://resend.com/domains).
EMAIL_FROM=NagarMitra Alerts <onboarding@resend.dev>

# The address that RECEIVES every new report. Defaults to the project owner's
# inbox for now, per instructions -- swap this for a real department email
# once you have one, or add more recipients separated by commas.
# IMPORTANT: until you verify your own domain on Resend, their shared sandbox
# sender can only deliver to the email address you signed up to Resend with.
# Sign up to Resend using this same address and it works immediately.
EMAIL_TO=nagarmitrasolution@gmail.com

# --- Classifier ---
# Minimum confidence (0-1) before a report is auto-categorized instead of
# being marked "needs review".
CLASSIFIER_CONFIDENCE_THRESHOLD=0.45

# --- Misc ---
DATABASE_PATH=./civic_reports.db
